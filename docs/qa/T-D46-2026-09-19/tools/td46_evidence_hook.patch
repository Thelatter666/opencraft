INSERTION POINT
---------------
game/client/src/main.cpp, inside the frame loop's `if (!paused)` block, directly
after the fixed-step loop:

            for (int i = 0; i < ticks; ++i) {
                client::run_tick(tick_ctx);
                ++game_ticks;
            }
+           <<< the block below goes here >>>

The block (verbatim; `gam`, `srv`, `client` and `glm` are already aliased in
main.cpp, and item_registry / inventory are already in scope):

            // ══════════ TEMPORARY EVIDENCE HOOK (T-D46) ══════════════════════
            // F7/F8 summon a Hollow Wretch (T-M2's hook, same shape); F9/F10 put
            // the four timber_* pieces on and take them off. REMOVED BEFORE THE
            // COMMIT - see tools/td46_evidence_hook.patch for why.
            {
                static bool f7_prev = false;
                static bool f8_prev = false;
                static bool f9_prev = false;
                static bool f10_prev = false;
                const auto edge = [](GLFWwindow *win, const int key, bool &prev) {
                    const bool down = glfwGetKey(win, key) == GLFW_PRESS;
                    const bool rising = down && !prev;
                    prev = down;
                    return rising;
                };
                const auto summon = [&](const char *mob_id, const glm::dvec3 &offset) {
                    const glm::dvec3 facing = client::view_dir(view_yaw, 0.0);
                    const glm::dvec3 side{-facing.z, 0.0, facing.x};
                    const glm::dvec3 spot = curr_state.position + facing * 2.0 + side * offset.z;
                    const auto type = authority.entity_types().find_id(mob_id);
                    if (type.has_value()) {
                        const srv::EntityId id = authority.summon_mob(*type, spot);
                        OC_LOG_INFO("EVIDENCE summon {} id={} at ({:.1f}, {:.1f}, {:.1f})", mob_id, id, spot.x,
                                    spot.y, spot.z);
                    }
                };
                const auto wear = [&](const bool on) {
                    const char *pieces[] = {"timber_headguard", "timber_cuirass", "timber_greaves", "timber_treads"};
                    for (int piece = 0; piece < gam::kArmorSlots; ++piece) {
                        const std::uint16_t item = item_registry.id_of(pieces[piece]);
                        interact.inventory.set_slot(gam::armor_slot_index(static_cast<gam::ArmorSlot>(piece)),
                                                    on ? gam::ItemStack::of(item, 1) : gam::ItemStack{});
                    }
                    const gam::ArmorTotals worn = client::equipped_armor(interact.inventory);
                    OC_LOG_INFO("EVIDENCE armour {}: {} cell(s), {} point(s), toughness {}",
                                on ? "ON" : "OFF",
                                on ? gam::kArmorSlots : 0, worn.points, worn.toughness);
                };
                if (edge(window, GLFW_KEY_F7, f7_prev)) {
                    summon("hollow_wretch", {0.0, 0.0, 0.0});
                }
                if (edge(window, GLFW_KEY_F8, f8_prev)) {
                    summon("hollow_wretch", {0.0, 0.0, 1.0});
                }
                if (edge(window, GLFW_KEY_F9, f9_prev)) {
                    wear(true);
                }
                if (edge(window, GLFW_KEY_F10, f10_prev)) {
                    wear(false);
                }
            }

`client::ArmorTotals` / `client::equipped_armor` are the delivered player_life.hpp
functions, so the "armour ON" log line is a read of the same totals the damage
path uses - it is a probe OF the product, printed, not a replacement for it.
